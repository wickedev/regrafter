/**
 * Integration Tests - Basic Move Operations
 *
 * These tests verify end-to-end functionality of:
 * - Simple sibling moves (Move.Before, Move.After)
 * - Moves within same parent
 * - Error cases (invalid selector, parse errors)
 *
 * Uses the actual regraft/move implementation to verify complete pipeline.
 */

import { describe, it, expect } from 'vitest';
import * as fs from 'fs';
import * as path from 'path';

// Import actual implementation
import {
  regraft,
  move,
  canMove,
  analyze,
  Move,
  type FileInput,
  type PositionSelector,
  isOk,
  isErr,
  unwrap,
} from '../../index.js';

// =============================================================================
// Test Fixtures
// =============================================================================

const FIXTURES_DIR = path.join(__dirname, '../../../test/fixtures');

function loadFixture(filename: string): string {
  return fs.readFileSync(path.join(FIXTURES_DIR, filename), 'utf-8');
}

/**
 * Inline test code for basic move tests
 */
const simpleJSXCode = `
function App() {
  return (
    <div>
      <header>Header</header>
      <main>Main</main>
      <footer>Footer</footer>
    </div>
  );
}
`;

const nestedJSXCode = `
function App() {
  return (
    <div>
      <section>
        <h1>Title</h1>
        <p>Paragraph</p>
      </section>
      <aside>Sidebar</aside>
    </div>
  );
}
`;

const fragmentCode = `
function App() {
  return (
    <>
      <div>First</div>
      <div>Second</div>
      <div>Third</div>
    </>
  );
}
`;

// =============================================================================
// Helper Functions
// =============================================================================

function createPositionSelector(
  file: string,
  line: number,
  column: number
): PositionSelector {
  return { file, line, column };
}

function createFileInput(path: string, content: string): FileInput {
  return { path, content };
}

// =============================================================================
// Test Suites
// =============================================================================

describe('Basic Move Integration Tests', () => {
  // ===========================================================================
  // Move.Before Integration Tests
  // ===========================================================================

  describe('Move.Before Integration', () => {
    it('should move footer before header using position selectors', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      // Position of <footer> is line 7 (footer line in simpleJSXCode)
      // Position of <header> is line 5
      const from = createPositionSelector('test.tsx', 7, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      const codes = move(files, from, to, Move.Before);

      expect(codes).toHaveLength(1);
      expect(codes[0]!.changed).toBe(true);

      // Verify footer comes before header in output
      const code = codes[0]!.content;
      const footerIndex = code.indexOf('<footer>');
      const headerIndex = code.indexOf('<header>');
      expect(footerIndex).toBeLessThan(headerIndex);
    });

    it('should preserve element content after move', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('test.tsx', 7, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      const codes = move(files, from, to, Move.Before);

      expect(codes[0]!.content).toBe("function App() {\n  return <div><footer>Footer</footer><header>Header</header><main>Main</main></div>;\n}");
    });

    it('should remove element from original location (no duplicates)', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('test.tsx', 7, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      const codes = move(files, from, to, Move.Before);

      // Footer should only appear once
      const footerMatches = codes[0]!.content.match(/<footer>/g);
      expect(footerMatches).toHaveLength(1);
    });

    it('should move nested element before sibling', () => {
      const files = [createFileInput('test.tsx', nestedJSXCode)];

      // Move <p> (line 7) before <h1> (line 6)
      const from = createPositionSelector('test.tsx', 7, 8);
      const to = createPositionSelector('test.tsx', 6, 8);

      const codes = move(files, from, to, Move.Before);

      expect(codes[0]!.changed).toBe(true);
      const code = codes[0]!.content;
      const pIndex = code.indexOf('<p>');
      const h1Index = code.indexOf('<h1>');
      expect(pIndex).toBeLessThan(h1Index);
    });
  });

  // ===========================================================================
  // Move.After Integration Tests
  // ===========================================================================

  describe('Move.After Integration', () => {
    it('should move header after footer using position selectors', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      // Move <header> (line 5) after <footer> (line 7)
      const from = createPositionSelector('test.tsx', 5, 6);
      const to = createPositionSelector('test.tsx', 7, 6);

      const codes = move(files, from, to, Move.After);

      expect(codes).toHaveLength(1);
      expect(codes[0]!.changed).toBe(true);

      // Verify header comes after footer in output
      const code = codes[0]!.content;
      const headerIndex = code.indexOf('<header>');
      const footerIndex = code.indexOf('<footer>');
      expect(headerIndex).toBeGreaterThan(footerIndex);
    });

    it('should preserve all elements after move', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('test.tsx', 5, 6);
      const to = createPositionSelector('test.tsx', 7, 6);

      const codes = move(files, from, to, Move.After);

      expect(codes[0]!.content).toBe("function App() {\n  return <div><main>Main</main><footer>Footer</footer><header>Header</header></div>;\n}");
    });
  });

  // ===========================================================================
  // Source-Target Identity Tests
  // ===========================================================================

  describe('Source-Target Identity Detection', () => {
    it('should return success with wasNoOp when moving element to itself', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      // Move header to its own position
      const from = createPositionSelector('test.tsx', 5, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      const result = regraft(files, from, to, Move.Before);

      expect(result.ok).toBe(true);
      // Content should be unchanged
    });

    it('should detect no-op via canMove for same position', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('test.tsx', 5, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      // canMove should still return true (it's a valid move, just no-op)
      expect(canMove(files, from, to, Move.Before)).toBe(true);
    });
  });

  // ===========================================================================
  // regraft() API Integration Tests
  // ===========================================================================

  describe('regraft() API', () => {
    it('should return complete Result object on success', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('test.tsx', 7, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      const result = regraft(files, from, to, Move.Before);

      expect(result.ok).toBe(true);
      if (result.ok) {
        expect(result.value.codes).toHaveLength(1);
        expect(result.value.codes[0]!.file).toBe('test.tsx');
        expect(result.value.codes[0]!.changed).toBe(true);
        expect(result.value.analysis).toBeDefined();
      }
    });

    it('should support dryRun option', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('test.tsx', 7, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      const result = regraft(files, from, to, Move.Before, { dryRun: true });

      expect(result.ok).toBe(true);
      if (result.ok) {
        expect(result.value.analysis).toBeDefined();
        // In dryRun, files should be unchanged
        expect(result.value.codes[0]!.changed).toBe(false);
      }
    });
  });

  // ===========================================================================
  // analyze() API Tests
  // ===========================================================================

  describe('analyze() API', () => {
    it('should return analysis without transformation', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('test.tsx', 7, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      const analysis = analyze(files, from, to, Move.Before);

      expect(analysis.canMove).toBe(true);
      expect(analysis.dependencies).toBeDefined();
      expect(analysis.stats).toBeDefined();
    });

    it('should return canMove=false for invalid moves', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      // Invalid position selector (non-JSX location)
      const from = createPositionSelector('test.tsx', 1, 1);
      const to = createPositionSelector('test.tsx', 5, 6);

      const analysis = analyze(files, from, to, Move.Before);

      expect(analysis.canMove).toBe(false);
      expect(analysis.reason).toBeDefined();
    });
  });

  // ===========================================================================
  // canMove() API Tests
  // ===========================================================================

  describe('canMove() API', () => {
    it('should return true for valid moves', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('test.tsx', 7, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      expect(canMove(files, from, to, Move.Before)).toBe(true);
      expect(canMove(files, from, to, Move.After)).toBe(true);
    });

    it('should return false for non-existent file', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('nonexistent.tsx', 5, 6);
      const to = createPositionSelector('test.tsx', 7, 6);

      expect(canMove(files, from, to, Move.Before)).toBe(false);
    });
  });

  // ===========================================================================
  // Error Cases
  // ===========================================================================

  describe('Error Cases', () => {
    it('should throw error for invalid source file', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      const from = createPositionSelector('nonexistent.tsx', 5, 6);
      const to = createPositionSelector('test.tsx', 7, 6);

      expect(() => move(files, from, to, Move.Before)).toThrow();
    });

    it('should throw error for position with no JSX element', () => {
      const files = [createFileInput('test.tsx', simpleJSXCode)];

      // Line 1 is a function declaration, not JSX
      const from = createPositionSelector('test.tsx', 1, 1);
      const to = createPositionSelector('test.tsx', 5, 6);

      expect(() => move(files, from, to, Move.Before)).toThrow();
    });

    it('should return failure result for parse errors', () => {
      const invalidCode = `
function App() {
  return (
    <div>
      <broken  // Missing closing tag
    </div>
  );
}
`;
      const files = [createFileInput('test.tsx', invalidCode)];

      const from = createPositionSelector('test.tsx', 5, 6);
      const to = createPositionSelector('test.tsx', 7, 6);

      expect(() => move(files, from, to, Move.Before)).toThrow();
    });

    it('should handle empty files array', () => {
      const from = createPositionSelector('test.tsx', 5, 6);
      const to = createPositionSelector('test.tsx', 7, 6);

      expect(() => move([], from, to, Move.Before)).toThrow();
    });
  });

  // ===========================================================================
  // Fragment Support Tests
  // ===========================================================================

  describe('Fragment Support', () => {
    it('should move elements within fragments', () => {
      const files = [createFileInput('test.tsx', fragmentCode)];

      // Move third div (line 7) before first div (line 5)
      const from = createPositionSelector('test.tsx', 7, 6);
      const to = createPositionSelector('test.tsx', 5, 6);

      const codes = move(files, from, to, Move.Before);

      expect(codes[0]!.changed).toBe(true);
      const code = codes[0]!.content;
      const thirdIndex = code.indexOf('Third');
      const firstIndex = code.indexOf('First');
      expect(thirdIndex).toBeLessThan(firstIndex);
    });
  });

  // ===========================================================================
  // Real Fixture File Tests
  // ===========================================================================

  describe('Real Fixture Tests', () => {
    it('should handle simple-component.tsx fixture', () => {
      const content = loadFixture('simple-component.tsx');
      const files = [createFileInput('simple-component.tsx', content)];

      // Move <footer> (around line 22) before <main> (around line 18)
      const from = createPositionSelector('simple-component.tsx', 22, 6);
      const to = createPositionSelector('simple-component.tsx', 18, 6);

      const codes = move(files, from, to, Move.Before);

      expect(codes[0]!.changed).toBe(true);
      // Verify the move happened
      const code = codes[0]!.content;
      expect(code).toBe(`// @ts-nocheck
/**
 * Simple Component Fixture
 *
 * Purpose: Test basic JSX element movement without dependencies
 * Scenarios:
 * - Move sibling elements (before/after)
 * - Move elements inside containers
 * - Basic selector resolution (position and path)
 */
import React from 'react';
export function SimpleComponent() {
  return <div className="container">
      <header>
        <h1>Title</h1>

      </header>
      <main><p>Content paragraph</p><span>Inline text</span></main>
      <footer>
        <small>Footer text</small>
      </footer>
    </div>;
}
export function ComponentWithProps({
  title,
  content
}: {
  title: string;
  content: string;
}) {
  return <article>
      <h2>{title}</h2>
      <p>{content}</p>
    </article>;
}
export function EmptyContainer() {
  return <div className="empty-container">
      {/* This container has no children */}
    </div>;
}
export function FragmentComponent() {
  return <>
      <span>First</span>
      <span>Second</span>
      <span>Third</span>
    </>;
}
export function SelfClosingElements() {
  return <div>
      <img src="/image.png" alt="Test" />
      <input type="text" placeholder="Enter text" />
      <br />
      <hr />
    </div>;
}`);
    });
  });
});
